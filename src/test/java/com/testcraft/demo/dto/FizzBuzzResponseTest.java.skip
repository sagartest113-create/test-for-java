package com.testcraft.demo.dto;

import org.junit.jupiter.api.Test;
import static org.assertj.core.api.Assertions.assertThat;
import static org.assertj.core.api.Assertions.assertThatThrownBy;
import java.util.List;
import java.util.Arrays;

public class FizzBuzzResponseTest {

    @Test
    @DisplayName("Constructs with valid input")
    void testConstructsWithValidInput() {
        var response = new FizzBuzzResponse(10, List.of());
        assertThat(response.n()).isEqualTo(10);
        assertThat(response.result()).isEmpty();
    }

    @Test
    @DisplayName("Constructs with invalid input (null)")
    void testConstructsWithInvalidInputNull() {
        assertThatThrownBy(() -> new FizzBuzzResponse(null, List.of()))
                .isInstanceOf(NullPointerException.class)
                .hasMessageContaining("n");
    }

    @Test
    @DisplayName("Constructs with invalid input (negative number)")
    void testConstructsWithInvalidInputNegativeNumber() {
        assertThatThrownBy(() -> new FizzBuzzResponse(-10, List.of()))
                .isInstanceOf(IllegalArgumentException.class)
                .hasMessageContaining("n must be greater than or equal to 0");
    }

    @Test
    @DisplayName("Accessors return correct values")
    void testAccessorsReturnCorrectValues() {
        var response = new FizzBuzzResponse(10, List.of());
        assertThat(response.n()).isEqualTo(10);
        assertThat(response.result()).isEmpty();
    }

    @Test
    @DisplayName("Equals returns true for equal objects")
    void testEqualsReturnsTrueForEqualObjects() {
        var response1 = new FizzBuzzResponse(10, List.of());
        var response2 = new FizzBuzzResponse(10, List.of());
        assertThat(response1).isEqualTo(response2);
    }

    @Test
    @DisplayName("Equals returns false for unequal objects")
    void testEqualsReturnsFalseForUnequalObjects() {
        var response1 = new FizzBuzzResponse(10, List.of());
        var response2 = new FizzBuzzResponse(20, List.of());
        assertThat(response1).isNotEqualTo(response2);
    }

    @Test
    @DisplayName("HashCode returns same value for equal objects")
    void testHashCodeReturnsSameValueForEqualObjects() {
        var response1 = new FizzBuzzResponse(10, List.of());
        var response2 = new FizzBuzzResponse(10, List.of());
        assertThat(response1.hashCode()).isEqualTo(response2.hashCode());
    }

    @Test
    @DisplayName("HashCode returns different values for unequal objects")
    void testHashCodeReturnsDifferentValuesForUnequalObjects() {
        var response1 = new FizzBuzzResponse(10, List.of());
        var response2 = new FizzBuzzResponse(20, List.of());
        assertThat(response1.hashCode()).isNotEqualTo(response2.hashCode());
    }

    @Test
    @DisplayName("ToString returns correct string representation")
    void testToStringReturnsCorrectStringRepresentation() {
        var response = new FizzBuzzResponse(10, List.of());
        assertThat(response.toString())
                .isEqualTo("FizzBuzzResponse[n=10, result=[]]");
    }
}