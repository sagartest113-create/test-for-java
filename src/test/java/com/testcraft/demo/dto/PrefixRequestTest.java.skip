package com.testcraft.demo.dto;

import jakarta.validation.ConstraintViolation;
import jakarta.validation.Validation;
import jakarta.validation.ValidatorFactory;
import org.assertj.core.api.Assertions;
import org.junit.jupiter.api.Test;
import java.util.List;

public class PrefixRequestTest {

    private final ValidatorFactory validatorFactory = Validation.buildDefaultValidatorFactory();
    private final Validator validator = validatorFactory.getValidator();

    @Test
    @DisplayName("Constructs with valid list")
    void testConstructsWithValidList() {
        List<String> words = List.of("word1", "word2");
        PrefixRequest request = new PrefixRequest(words);
        Assertions.assertThat(request.words()).isEqualTo(words);
    }

    @Test
    @DisplayName("Constructs with empty list")
    void testConstructsWithEmptyList() {
        List<String> words = List.of();
        PrefixRequest request = new PrefixRequest(words);
        Assertions.assertThat(request.words()).isEqualTo(words);
    }

    @Test
    @DisplayName("Fails to construct with null list")
    void testFailsToConstructWithNullList() {
        Assertions.assertThatThrownBy(() -> new PrefixRequest(null))
                .isInstanceOf(NullPointerException.class);
    }

    @Test
    @DisplayName("Validates valid input")
    void testValidatesValidInput() {
        List<String> words = List.of("word1", "word2");
        PrefixRequest request = new PrefixRequest(words);
        var violations = validator.validate(request).iterator();
        Assertions.assertThat(violations).hasNoMoreElements();
    }

    @Test
    @DisplayName("Fails to validate empty list")
    void testFailsToValidateEmptyList() {
        List<String> words = List.of();
        PrefixRequest request = new PrefixRequest(words);
        var violations = validator.validate(request).iterator();
        Assertions.assertThat(violations)
                .hasNext()
                .next()
                .isInstanceOf(ConstraintViolation.class);
    }

    @Test
    @DisplayName("Fails to validate null list")
    void testFailsToValidateNullList() {
        List<String> words = null;
        Assertions.assertThatThrownBy(() -> new PrefixRequest(words))
                .isInstanceOf(NullPointerException.class);
    }

    @Test
    @DisplayName("Equals returns true for equal objects")
    void testEqualsReturnsTrueForEqualObjects() {
        List<String> words1 = List.of("word1", "word2");
        List<String> words2 = List.of("word1", "word2");
        PrefixRequest request1 = new PrefixRequest(words1);
        PrefixRequest request2 = new PrefixRequest(words2);
        Assertions.assertThat(request1.equals(request2)).isTrue();
    }

    @Test
    @DisplayName("Equals returns false for unequal objects")
    void testEqualsReturnsFalseForUnequalObjects() {
        List<String> words1 = List.of("word1", "word2");
        List<String> words2 = List.of("word3", "word4");
        PrefixRequest request1 = new PrefixRequest(words1);
        PrefixRequest request2 = new PrefixRequest(words2);
        Assertions.assertThat(request1.equals(request2)).isFalse();
    }

    @Test
    @DisplayName("HashCode returns equal hash code for equal objects")
    void testHashCodeReturnsEqualHashCodeForEqualObjects() {
        List<String> words1 = List.of("word1", "word2");
        List<String> words2 = List.of("word1", "word2");
        PrefixRequest request1 = new PrefixRequest(words1);
        PrefixRequest request2 = new PrefixRequest(words2);
        Assertions.assertThat(request1.hashCode()).isEqualTo(request2.hashCode());
    }

    @Test
    @DisplayName("HashCode returns unequal hash code for unequal objects")
    void testHashCodeReturnsUnequalHashCodeForUnequalObjects() {
        List<String> words1 = List.of("word1", "word2");
        List<String> words2 = List.of("word3", "word4");
        PrefixRequest request1 = new PrefixRequest(words1);
        PrefixRequest request2 = new PrefixRequest(words2);
        Assertions.assertThat(request1.hashCode()).isNotEqualTo(request2.hashCode());
    }

    @Test
    @DisplayName("ToString returns string representation of object")
    void testToStringReturnsStringRepresentationOfObject() {
        List<String> words = List.of("word1", "word2");
        PrefixRequest request = new PrefixRequest(words);
        Assertions.assertThat(request.toString()).isEqualTo("PrefixRequest[words=[word1, word2]]");
    }
}