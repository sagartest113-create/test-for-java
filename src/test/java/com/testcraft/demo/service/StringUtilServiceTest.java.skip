package com.testcraft.demo.service;

import org.junit.jupiter.api.Test;
import org.junit.jupiter.api.extension.ExtendWith;
import org.mockito.InjectMocks;
import org.mockito.Mock;
import org.mockito.junit.jupiter.MockitoExtension;

import static org.assertj.core.api.Assertions.assertThat;
import static org.junit.jupiter.api.Assertions.assertThrows;
import static org.mockito.Mockito.verify;
import static org.mockito.Mockito.when;

@ExtendWith(MockitoExtension.class)
public class StringUtilServiceTest {

    @Mock
    private String input1, input2, input3, input4, input5;

    @InjectMocks
    private StringUtilService stringUtilService;

    @Test
    @DisplayName("isPalindrome: happy path")
    void testIsPalindrome_HappyPath() {
        when(input1).thenReturn("radar");
        boolean result = stringUtilService.isPalindrome(input1);
        assertThat(result).isTrue();
    }

    @Test
    @DisplayName("isPalindrome: null input")
    void testIsPalindrome_NullInput() {
        assertThrows(IllegalArgumentException.class, () -> stringUtilService.isPalindrome(null));
    }

    @Test
    @DisplayName("isPalindrome: non-alphanumeric characters")
    void testIsPalindrome_NonAlphanumericCharacters() {
        when(input2).thenReturn("123!@#");
        boolean result = stringUtilService.isPalindrome(input2);
        assertThat(result).isTrue();
    }

    @Test
    @DisplayName("reverseWords: happy path")
    void testReverseWords_HappyPath() {
        String trimmedInput3 = "Hello World!";
        when(input3).thenReturn(trimmedInput3);
        String result = stringUtilService.reverseWords(input3);
        assertThat(result).isEqualTo("World! Hello");
    }

    @Test
    @DisplayName("reverseWords: null input")
    void testReverseWords_NullInput() {
        assertThrows(IllegalArgumentException.class, () -> stringUtilService.reverseWords(null));
    }

    @Test
    @DisplayName("reverseWords: empty input")
    void testReverseWords_EmptyInput() {
        when(input4).thenReturn("");
        String result = stringUtilService.reverseWords(input4);
        assertThat(result).isEmpty();
    }

    @Test
    @DisplayName("charFrequency: happy path")
    void testCharFrequency_HappyPath() {
        String input5 = "Hello World!";
        when(input5).thenReturn(input5);
        Map<Character, Integer> result = stringUtilService.charFrequency(input5);
        assertThat(result).containsEntry('H', 1)
                .containsEntry('e', 1)
                .containsEntry('l', 3)
                .containsEntry('o', 2)
                .containsEntry(' ', 1)
                .containsEntry('W', 1)
                .containsEntry('r', 1)
                .containsEntry('d', 1);
    }

    @Test
    @DisplayName("charFrequency: null input")
    void testCharFrequency_NullInput() {
        assertThrows(IllegalArgumentException.class, () -> stringUtilService.charFrequency(null));
    }

    @Test
    @DisplayName("camelToSnake: happy path")
    void testCamelToSnake_HappyPath() {
        when(input1).thenReturn("myVariableName");
        String result = stringUtilService.camelToSnake(input1);
        assertThat(result).isEqualTo("my_variable_name");
    }

    @Test
    @DisplayName("camelToSnake: null input")
    void testCamelToSnake_NullInput() {
        assertThrows(IllegalArgumentException.class, () -> stringUtilService.camelToSnake(null));
    }

    @Test
    @DisplayName("camelToSnake: empty input")
    void testCamelToSnake_EmptyInput() {
        when(input2).thenReturn("");
        String result = stringUtilService.camelToSnake(input2);
        assertThat(result).isEmpty();
    }

    @Test
    @DisplayName("longestCommonPrefix: happy path")
    void testLongestCommonPrefix_HappyPath() {
        String[] strs = new String[]{"hello", "hellow"};
        when(stringUtilService.longestCommonPrefix(strs)).thenReturn("hel");
        String result = stringUtilService.longestCommonPrefix(strs);
        assertThat(result).isEqualTo("hel");
    }

    @Test
    @DisplayName("longestCommonPrefix: null input")
    void testLongestCommonPrefix_NullInput() {
        assertThrows(IllegalArgumentException.class, () -> stringUtilService.longestCommonPrefix(null));
    }

    @Test
    @DisplayName("longestCommonPrefix: empty array")
    void testLongestCommonPrefix_EmptyArray() {
        String[] strs = new String[]{};
        when(stringUtilService.longestCommonPrefix(strs)).thenReturn("");
        String result = stringUtilService.longestCommonPrefix(strs);
        assertThat(result).isEmpty();
    }
}